{
  "Mode": "JetStream",
  "Processing": {
    "StreamName": "CAT_FEEDINGS",
    "Subject": "cat.feedings",
    "DurableConsumerName": "cat-feeding-processors",
    "QueueGroup": "cat-feeding-processors",
    "InstanceName": "consumer-1",
    "PrefetchCount": 1,
    "DelayMs": 100
  },
  "Nats": {
    "Url": "nats://localhost:4222"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
