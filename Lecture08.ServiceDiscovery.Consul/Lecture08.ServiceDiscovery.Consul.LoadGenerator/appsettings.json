{
  "LoadGenerator": {
    "Mode": "ServerSide",
    "Url": "http://localhost:8080/cats/1",
    "ConsulUrl": "http://localhost:8500",
    "RequestsPerSecond": 100,
    "MaxConnections": 5000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
