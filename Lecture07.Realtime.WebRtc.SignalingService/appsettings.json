{
  "IceServers": {
    "Stun": [
      { "Urls": "stun:stun.l.google.com:19302" }
    ],
    "Turn": [
      { "Urls": "turn:localhost:3478", "Username": "student", "Credential": "student" }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
