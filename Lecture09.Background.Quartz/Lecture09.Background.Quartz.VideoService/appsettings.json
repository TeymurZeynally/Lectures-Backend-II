{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=quartz;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Quartz": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{Context}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
