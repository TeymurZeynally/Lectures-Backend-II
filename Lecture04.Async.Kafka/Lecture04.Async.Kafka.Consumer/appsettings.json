{
  "Processing":{
    "DelayMs": 0
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "GroupId": "cat-feeding-processors",
    "ClientId": "consumer-1",
    "AutoOffsetReset": "Earliest",
    "Topic": "cat-feedings",
    "SessionTimeoutMs": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
