        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource}"
        },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "",
          "type": 1
        },
        "refresh": 1,
        "regex": "",
        "regexApplyTo": "value",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query",
        "label": "Service",
        "allValue": ".+"
      },
      {
        "name": "level",
        "label": "Severity",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": "trace,debug,info,warn,error,critical",
        "current": {
