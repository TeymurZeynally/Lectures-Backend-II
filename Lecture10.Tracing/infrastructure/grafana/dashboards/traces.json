{
  "uid": "lecture10-traces",
  "title": "Traces",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "",
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "prom_datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "tempo_datasource",
        "type": "datasource",
        "query": "tempo",
        "hide": 2,
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom_datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "definition": "label_values(traces_spanmetrics_calls_total, service)",
        "query": {
          "qryType": 1,
          "query": "label_values(traces_spanmetrics_calls_total, service)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {}
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Span metrics (generated by Tempo)",
      "collapsed": false,
      "id": 1,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Spans per second",
      "description": "traces_spanmetrics_calls_total: how many times per second each operation (span name) runs.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error spans per second",
      "description": "traces_spanmetrics_calls_total with status Error.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Span duration p99",
      "description": "traces_spanmetrics_latency: 99th percentile of each operation duration.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average span duration",
      "description": "traces_spanmetrics_latency: sum of durations / count.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_latency_sum{service=\"$service\"}[$__rate_interval])) / sum by (span_name) (rate(traces_spanmetrics_latency_count{service=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "HTTP requests: from metric to trace",
      "collapsed": false,
      "id": 6,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP request duration (with exemplars)",
      "description": "http.server.request.duration. Dots are exemplars: single measurements with a trace_id. Click a dot to open the trace of that request.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP requests per second by status code",
      "description": "http.server.request.duration count by http_response_status_code.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${prom_datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom_datasource}"
          },
          "editorMode": "code",
          "range": true,
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Service graph",
      "collapsed": false,
      "id": 9,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service graph",
      "description": "Built by Tempo from Client/Server span pairs: traces_service_graph_request_total.",
      "id": 10,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "serviceMap",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "id": 11,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      }
    },
    {
      "type": "table",
      "title": "Recent traces",
      "description": "TraceQL: traces with spans of the service. Click a Trace ID to show the trace below.",
      "id": 12,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace on this dashboard",
                    "url": "/d/lecture10-traces/traces?${__url_time_range}&${service:queryparam}&var-trace_id=${__value.raw}"
                  },
                  {
                    "title": "Show logs of this trace (new tab)",
                    "url": "/d/lecture10-logs/logs?${__url_time_range}&${service:queryparam}&var-trace_id=${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" } with (most_recent=true)",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Slow traces (> 1 s)",
      "description": "TraceQL: traces where a span of the service took longer than one second. Click a Trace ID to show the trace below.",
      "id": 13,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace on this dashboard",
                    "url": "/d/lecture10-traces/traces?${__url_time_range}&${service:queryparam}&var-trace_id=${__value.raw}"
                  },
                  {
                    "title": "Show logs of this trace (new tab)",
                    "url": "/d/lecture10-logs/logs?${__url_time_range}&${service:queryparam}&var-trace_id=${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && duration > 1s } with (most_recent=true)",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Traces with errors",
      "description": "TraceQL: traces that contain a span with status Error. Click a Trace ID to show the trace below.",
      "id": 14,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace on this dashboard",
                    "url": "/d/lecture10-traces/traces?${__url_time_range}&${service:queryparam}&var-trace_id=${__value.raw}"
                  },
                  {
                    "title": "Show logs of this trace (new tab)",
                    "url": "/d/lecture10-logs/logs?${__url_time_range}&${service:queryparam}&var-trace_id=${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && status = error } with (most_recent=true)",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Trace $trace_id",
      "description": "The trace selected in the tables above (variable trace_id). A trace ID can also be pasted into the Trace ID field at the top.",
      "id": 15,
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "links": [
        {
          "title": "Logs of this trace (new tab)",
          "url": "/d/lecture10-logs/logs?${__url_time_range}&${service:queryparam}&var-trace_id=${trace_id}",
          "targetBlank": true
        }
      ],
      "gridPos": {
        "h": 22,
        "w": 24,
        "x": 0,
        "y": 53
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "${trace_id}",
          "refId": "A"
        }
      ]
    }
  ]
}