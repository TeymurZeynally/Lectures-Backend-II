{
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1,127.0.0.2,127.0.0.3;Port=5432;Database=cats;Username=postgres;Password=postgres;Target Session Attributes=primary;Host Recheck Seconds=2"
  },
  "LoadGenerator": {
    "ParallelWorkers": 10,
    "UpdateDelayMs": 100
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
