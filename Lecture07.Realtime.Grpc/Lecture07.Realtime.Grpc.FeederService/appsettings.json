{
  "ShelterService": {
    "BaseUrl": "http://localhost:5073"
  },
  "Feeder": {
    "FeederId": "feeder-1",
    "CatName": "Барсик",
    "CapacityGrams": 200
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
